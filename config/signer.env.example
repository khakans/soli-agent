# PRIVATE signer service account ONLY. Never give these to Hermes or the engine.
SOLI_DRY_RUN=true
SOLI_SIGNING_BACKEND=local
# Hex or base58 Solana seed/keypair, or quoted JSON keypair. Never a recovery phrase.
SOLI_PRIVATE_KEY=
SOLI_EXPECTED_WALLET=
SOLI_API_TOKEN=replace-with-same-agent-token-as-engine
SOLI_OWNER_TOKEN=replace-with-different-random-owner-token-at-least-32-characters
SOLI_SIGNER_DB=signer-data/live.db
SOLI_STRATEGY_FILE=config/strategy.json
SOLI_RPC_URL=
JUPITER_API_KEY=
GOPLUS_TOKEN=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# Optional alternative: set SOLI_SIGNING_BACKEND=vault and leave SOLI_PRIVATE_KEY empty.
# VAULT_ADDR=https://vault.example.invalid:8200
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY=soli
SOLI_LIVE_MAX_POSITION_USDC=5000000
SOLI_LIVE_DAILY_SPEND_USDC=20000000
# For /soli approvals, set platform-specific connector secrets and owner IDs here too.
# SOLI_BRIDGE_SECRETS_JSON={"slack":"...","telegram":"...","discord":"..."}
# SOLI_OWNERS_JSON={"slack":["U..."],"telegram":["123456"],"discord":["123456789"]}
