# Copy to SOLI_HOME/.env. Native run/start/doctor/configure load this service profile.
# .env takes precedence over legacy engine.json/signer.json in the same SOLI_HOME.
SOLI_API_TOKEN=replace-with-a-random-token-at-least-32-characters
SOLI_DRY_RUN=true
JUPITER_API_KEY=
SOLI_RPC_URL=
SOLI_WS_URL=
GOPLUS_TOKEN=
# App credentials take precedence over a manually supplied token. Set both.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
SOLI_DB=data/soli.db
SOLI_ENTRY_TRIGGER=wallet_convergence
SOLI_SMART_WALLETS=
SOLI_WATCH_MINTS=
SOLI_AUTO_PAPER=false
SOLI_STRATEGY_FILE=config/strategy.json
# Native installer sets an absolute path to its hashed agent registry.
SOLI_AGENT_KEYS_FILE=
# Optional path to notification target metadata; tokens are kept in secret env inputs.
SOLI_NOTIFICATIONS_FILE=
SOLI_SIGNER_URL=http://127.0.0.1:8788
# SIGNER ONLY: keep private keys in the separate signer account's .env.
# Leave these blank in the engine and never expose them to a model host.
SOLI_SIGNING_BACKEND=local
SOLI_PRIVATE_KEY=
SOLI_EXPECTED_WALLET=
SOLI_WALLET_ADDRESS=
# Learning uses completed forward evidence. Auto-apply is paper-only and restarts service.
SOLI_LEARNING_AUTO_APPLY=false
# Connector-only secrets; separate random >=32-character value per enabled platform.
# Set BOTH JSON variables or leave both absent to disable bridge commands.
# SOLI_BRIDGE_SECRETS_JSON={"slack":"...","telegram":"...","discord":"..."}
# SOLI_OWNERS_JSON={"slack":["U..."],"telegram":["123456"],"discord":["123456789"]}
# USDC base units: 1 USDC = 1,000,000. All balances below are virtual.
SOLI_INITIAL_USDC=1000000000
# Conservative estimated network/priority/account costs per simulated fill.
# This is a configurable estimate, NOT an actual fee quote.
SOLI_PAPER_FEE_USDC=100000
